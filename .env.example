# ==============================================================================
# android-telegram-monitor — plantilla de entorno (.env.example)
# Copiar este archivo a .env y rellenar los valores reales.
# .env está en .gitignore: NUNCA se sube a git.
# ==============================================================================

# --- Credenciales Telegram (usadas por monitor.sh) ---
TELEGRAM_TOKEN="TU_TOKEN_DE_TELEGRAM_AQUI"
CHAT_ID="TU_CHAT_ID_AQUI"
DEVICE_ALIAS="Mi Servidor"

# --- Credenciales SSH al dispositivo productivo (donde se despliega el monitor) ---
PRODUCTIVE_HOST="192.168.x.x"
PRODUCTIVE_USER="conrack"
PRODUCTIVE_PORT="22"
PRODUCTIVE_SSH_KEY="~/.ssh/id_ed25519"
PRODUCTIVE_PASSWORD="TU_CONTRASEÑA_AQUI"
